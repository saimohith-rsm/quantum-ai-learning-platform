# ==========================================
# QuantumAI Backend Environment Configuration
# ==========================================

# Server Host & Port
PORT=8000
HOST=127.0.0.1

# Database URL (Defaults to local SQLite database)
DATABASE_URL=sqlite:///quantum_learning.db

# Authentication Secret (Change to a strong random 32+ character string in production)
JWT_SECRET=quantum-ai-sih-2026-human-x-secret-change-in-production

# CORS Allowed Origins (Comma-separated list)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Optional AI Engine API Keys (Platform operates 100% offline with local verified quantum KB if unset)
GEMINI_API_KEY=
OPENAI_API_KEY=
DEFAULT_AI_PROVIDER=gemini
